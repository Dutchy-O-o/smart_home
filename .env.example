# Build-time secrets, injected via --dart-define. NEVER committed.
#
# Run with explicit flags:
#
#   flutter run \
#     --dart-define=CLAUDE_API_KEY=sk-ant-... \
#     --dart-define=SPOTIFY_CLIENT_ID=... \
#     --dart-define=SPOTIFY_CLIENT_SECRET=... \
#     --dart-define=EMOTION_API_URL=https://ramazan.local:8000/predict
#
# Or use a JSON args file (recommended — keeps IDE launch configs clean):
#
#   flutter run --dart-define-from-file=dart-define-args.json
#
# where dart-define-args.json is:
# {
#   "CLAUDE_API_KEY": "sk-ant-...",
#   "SPOTIFY_CLIENT_ID": "...",
#   "SPOTIFY_CLIENT_SECRET": "...",
#   "EMOTION_API_URL": "https://ramazan.local:8000/predict"
# }
#
# Both `.env` and `dart-define-args.json` are gitignored. The legacy `.env`
# file is no longer loaded at runtime — kept here for reference only.

CLAUDE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
EMOTION_API_URL=https://ramazan.local:8000/predict
